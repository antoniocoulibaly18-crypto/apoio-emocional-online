# Crie um projeto gratuito em https://supabase.com, depois vá em
# Project Settings -> API e copie os valores abaixo para um ficheiro .env.local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da API do Google Gemini (usada pelo assistente empático em /api/chat).
# GRÁTIS, sem cartão de crédito: crie a sua em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
